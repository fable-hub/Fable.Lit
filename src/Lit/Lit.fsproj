<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <PackageId>Fable.Lit</PackageId>
    <Version>1.4.2</Version>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NpmDependencies>
      <NpmPackage Name="lit" Version="gte 2.0.0" ResolutionStrategy="Max" />
      <!-- Hydrate.fs imports this at module level and Lit.Elmish imports Hydrate, so a
           bundler has to resolve it for every consumer of either, including one that
           never hydrates anything. Declared so it appears as a dependency rather than as
           "Rollup failed to resolve import" the first time somebody builds. Nothing of it
           reaches the output unless adopt is called: the import resolves, and then tree
           shaking takes it away again.
           (No double hyphen in this file. MSBuild parses it as XML, where two of them in
           a comment is a parse error.) -->
      <NpmPackage Name="@lit-labs/ssr-client" Version="gte 1.0.0" ResolutionStrategy="Max" />
    </NpmDependencies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Parser.fs" />
    <Compile Include="Template.fs" />
    <Compile Include="Lit.fs" />
    <Compile Include="HMR.fs" />
    <Compile Include="Hook.fs" />
    <Compile Include="LitElement.fs" />
    <!-- Opt-in, and the only file that touches @lit-labs/ssr-client. -->
    <Compile Include="Hydrate.fs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="*.fsproj; *.fs; package.json" PackagePath="fable\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="5.0.0" />
    <PackageReference Include="Fable.Core" Version="4.0.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.5.0" />
    <PackageReference Include="Fable.Promise" Version="3.1.0" />
  </ItemGroup>
</Project>